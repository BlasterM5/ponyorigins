{
    "hidden": true,
    "type": "origins:multiple",
    "level_bar": {
        "type": "origins:resource",
        "min": 0,
        "max": 100,
        "start_value": 100,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/resource_bar.png",
            "bar_index": 7,
            "condition": {
                "type": "origins:and",
                "conditions": [
                    {
                        "type": "origins:resource",
                        "resource": "ponyorigins:common/diet/lithovore_supercharge",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    {
                        "type": "origins:resource",
                        "resource": "ponyorigins:common/diet/lithovore_obsidian_slag",
                        "comparison": "==",
                        "compare_to": 0
                    }
                ]
            }
        }
    },
    "bar_sync": {
        "type": "origins:action_over_time",
