                },
                {
                    "type": "origins-math:set_resource",
                    "resource": "*:*_supercharge_bar",
                    "value": "ponyorigins:common/diet/lithovore_level"
                },
                {
                    "type": "origins-math:set_resource",
                    "resource": "*:*_slag_bar",
                    "value": "ponyorigins:common/diet/lithovore_obsidian_slag"
                }
            ]
        }
    },
    "supercharge_bar": {
        "type": "origins:resource",
        "min": 0,
