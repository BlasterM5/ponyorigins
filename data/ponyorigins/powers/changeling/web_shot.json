{
    "name": "Web Shot",
    "description": "Press to shot web.",
    "badges": [
        {
            "type": "origins:tooltip",
            "text": [
                "Press [",
                {
                    "keybind": "key.origins.secondary_active"
                },
                "] to shot web"
            ],
            "sprite": "textures/block/cobweb.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Eating food fills your silk",
            "sprite": "textures/item/bread.png"
        }
    ],
    "type": "origins:multiple",
    "silk": {
        "type": "origins:resource",
        "min": 0,
        "max": 100,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/resource_bar.png",
            "bar_index": 5
        }
    },
    "food": {
        "type": "origins:resource",
        "min": 0,
        "max": 200,
        "start_value": 0
    },
    "silk_maker": {
        "type": "origins:action_over_time",
        "interval": 5,
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_food",
                "comparison": ">",
                "compare_to": 0
            },
            "if_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_food",
                        "change": -2,
                        "operation": "add"
                    },
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_silk",
                        "change": 1,
                        "operation": "add"
                    }
                ]
            }
        }
    },
    "split_nutrition": {
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": "<",
                    "compare_to": 20
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_silk",
                    "comparison": "<",
                    "compare_to": 100
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_food",
                    "comparison": "<=",
                    "compare_to": 100
                },
                {
                    "inverted": true,
                    "type": "origins:origin",
                    "origin": "ponyorigins:species/changeling"
                }
            ]
        },
        "type": "origins:modify_food",
        "food_modifier": {
            "operation": "multiply_total_additive",
            "value": -0.5
        },
        "saturation_modifier": {
            "operation": "multiply_total_additive",
            "value": -0.5
        },
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_food",
            "change": 50,
            "operation": "add"
        },
        "always_edible": true
    },
    "food_full": {
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food_level",
                    "comparison": "==",
                    "compare_to": 20
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_silk",
                    "comparison": "<",
                    "compare_to": 100
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_food",
                    "comparison": "<=",
                    "compare_to": 100
                },
                {
                    "inverted": true,
                    "type": "origins:origin",
                    "origin": "ponyorigins:species/changeling"
                }
            ]
        },
        "type": "origins:modify_food",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_food",
            "change": 100,
            "operation": "add"
        },
        "always_edible": true
    },
    "shot_web": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_silk",
            "comparison": ">=",
            "compare_to": 25
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "sync:custom_projectile",
                    "entity_id": "webshot",
                    "texture_location": "textures/block/cobweb.png",
                    "count": 1,
                    "speed": 2,
                    "divergence": 1,
                    "sound": "entity.llama.spit",
                    "bientity_action_after_firing": {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:change_resource",
                            "resource": "*:*_silk",
                            "change": -25,
                            "operation": "add"
                        }
                    },
                    "block_action_on_hit": {
                        "type": "origins:if_else",
                        "condition": {
                            "type": "origins:block",
                            "block": "air"
                        },
                        "if_action": {
                            "type": "origins:set_block",
                            "block": "cobweb"
                        },
                        "else_action": {
                            "type": "origins:if_else",
                            "condition": {
                                "type": "origins:and",
                                "conditions": [
                                    {
                                        "inverted": true,
                                        "type": "origins:in_tag",
                                        "tag": "doors"
                                    },
                                    {
                                        "inverted": true,
                                        "type": "origins:in_tag",
                                        "tag": "trapdoors"
                                    }
                                ]
                            },
                            "if_action": {
                                "type": "origins:add_block",
                                "block": "cobweb"
                            }
                        }
                    },
                    "block_action_cancels_miss_action": false,
                    "bientity_action_on_hit": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:target_action",
                                "action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "ponyorigins:common/hazard_webbed",
                                            "change": 100,
                                            "operation": "add"
                                        },
                                        {
                                            "type": "origins:if_else",
                                            "condition": {
                                                "type": "origins:and",
                                                "conditions": [
                                                    {
                                                        "type": "origins:block_in_radius",
                                                        "block_condition": {
                                                            "type": "origins:movement_blocking"
                                                        },
                                                        "radius": 1,
                                                        "shape": "sphere",
                                                        "comparison": ">",
                                                        "compare_to": 0
                                                    },
                                                    {
                                                        "type": "origins:block_in_radius",
                                                        "block_condition": {
                                                            "type": "origins:or",
                                                            "conditions": [
                                                                {
                                                                    "type": "origins:in_tag",
                                                                    "tag": "doors"
                                                                },
                                                                {
                                                                    "type": "origins:in_tag",
                                                                    "tag": "trapdoors"
                                                                }
                                                            ]
                                                        },
                                                        "radius": 1,
                                                        "shape": "sphere",
                                                        "comparison": "==",
                                                        "compare_to": 0
                                                    }
                                                ]
                                            },
                                            "if_action": {
                                                "type": "origins:block_action_at",
                                                "block_action": {
                                                    "type": "origins:if_else",
                                                    "condition": {
                                                        "type": "origins:block",
                                                        "block": "air"
                                                    },
                                                    "if_action": {
                                                        "type": "origins:set_block",
                                                        "block": "cobweb"
                                                    },
                                                    "else_action": {
                                                        "type": "origins:add_block",
                                                        "block": "cobweb"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "type": "origins:apply_effect",
                                            "effect": {
                                                "effect": "slowness",
                                                "duration": 200,
                                                "amplifier": 4,
                                                "is_ambient": true,
                                                "show_particles": false,
                                                "show_icon": true
                                            }
                                        },
                                        {
                                            "type": "origins:execute_command",
                                            "command": "particle item cobweb ~ ~ ~ 0.5 0.5 0.5 0.1 32 force"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    "tick_bientity_action": {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:execute_command",
                            "command": "particle item cobweb ~ ~ ~ 0.1 0.1 0.1 0.1 4 force"
                        }
                    }
                }
            ]
        },
        "cooldown": 10,
        "key": {
            "key": "key.origins.secondary_active",
            "continuous": true
        }
    }
}