    "level": {
        "type": "origins:resource",
        "min": 0,
        "max": 1000,
        "start_value": 100,
        "min_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_supercharge",
                "comparison": "==",
                "compare_to": 1
            },
            "if_action": {
                "type": "origins:change_resource",
                "resource": "*:*_obsidian_slag",
                "change": 40,
                "operation": "add"
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "*:*_cd",
                "change": 1,
                "operation": "add"
            }
        }
    },
    "recharge": {
        "type": "origins:action_over_time",
        "interval": 8,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_level",
                        "comparison": "<",
                        "compare_to": 100
                    },
                    "if_action": {
                        "type": "origins:if_else",
                        "condition": {
                            "type": "origins:and",
                            "conditions": [
                                {
                                    "type": "origins:resource",
                                    "resource": "*:*_supercharge",
                                    "comparison": "==",
                                    "compare_to": 0
                                },
                                {
                                    "type": "origins:resource",
                                    "resource": "*:*_cd",
                                    "comparison": "==",
                                    "compare_to": 0
                                }
                            ]
                        },
                        "if_action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:if_else",
                                    "condition": {
                                        "type": "origins:food_level",
                                        "comparison": ">=",
                                        "compare_to": 6
                                    },
                                    "if_action": {
                                        "type": "origins:and",
                                        "actions": [
                                            {
                                                "type": "origins:exhaust",
                                                "amount": 0.25
                                            },
                                            {
                                                "type": "origins:change_resource",
                                                "resource": "*:*_level",
                                                "change": 1,
                                                "operation": "add"
                                            }
                                        ]
                                    }
                                },
                                {
                                    "type": "origins:if_else",
                                    "condition": {
                                        "type": "origins:exposed_to_sun"
                                    },
                                    "if_action": {
                                        "type": "origins:change_resource",
                                        "resource": "*:*_level",
                                        "change": 1,
                                        "operation": "add"
                                    }
                                },
                                {
                                    "type": "origins:if_else",
                                    "condition": {
                                        "type": "origins:fluid_height",
                                        "fluid": "lava",
                                        "comparison": ">",
                                        "compare_to": 0
                                    },
                                    "if_action": {
                                        "type": "origins:if_else_list",
                                        "actions": [
                                            {
                                                "condition": {
                                                    "type": "origins:fluid_height",
                                                    "fluid": "lava",
                                                    "comparison": ">=",
                                                    "compare_to": 0.75
                                                },
                                                "action": {
                                                    "type": "origins:change_resource",
                                                    "resource": "*:*_level",
                                                    "change": 4,
                                                    "operation": "add"
                                                }
                                            },
                                            {
                                                "condition": {
                                                    "type": "origins:fluid_height",
                                                    "fluid": "lava",
                                                    "comparison": ">=",
                                                    "compare_to": 0.5
                                                },
                                                "action": {
                                                    "type": "origins:change_resource",
                                                    "resource": "*:*_level",
                                                    "change": 3,
                                                    "operation": "add"
                                                }
                                            },
                                            {
                                                "condition": {
                                                    "type": "origins:fluid_height",
                                                    "fluid": "lava",
                                                    "comparison": ">=",
                                                    "compare_to": 0.25
                                                },
                                                "action": {
                                                    "type": "origins:change_resource",
                                                    "resource": "*:*_level",
                                                    "change": 2,
                                                    "operation": "add"
                                                }
                                            },
                                            {
                                                "condition": {
                                                    "type": "origins:constant",
                                                    "value": true
                                                },
                                                "action": {
                                                    "type": "origins:change_resource",
                                                    "resource": "*:*_level",
                                                    "change": 1,
                                                    "operation": "add"
                                                }
                                            }
                                        ]
                                    }
                                },
                                {
                                    "type": "origins:if_else",
                                    "condition": {
                                        "type": "origins:on_fire"
                                    },
                                    "if_action": {
                                        "type": "origins:change_resource",
                                        "resource": "*:*_level",
                                        "change": 2,
                                        "operation": "add"
                                    }
                                }
                            ]
                        }
                    },
                    "else_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:change_resource",
                                "resource": "*:*_level",
                                "change": -2,
                                "operation": "add"
                            },
                            {
                                "type": "origins:if_else",
                                "condition": {
                                    "type": "origins:resource",
                                    "resource": "*:*_supercharge",
                                    "comparison": "==",
                                    "compare_to": 1
                                },
                                "if_action": {
                                    "type": "origins:execute_command",
                                    "command": "particle flame ~ ~0.5 ~-0.25 0.2 0.2 0.2 0.05 8 force"
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:in_block",
                        "block_condition": {
                            "type": "origins:block",
                            "block": "powder_snow"
                        }
                    },
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins-math:variable_change_resource",
                                "resource": "*:*_level",
                                "expression": "-(4-c)",
                                "variables": {
                                    "c": "ponyorigins:common/hazard_complexity_armor"
                                },
                                "operation": "add"
                            },
                            {
                                "type": "origins:extinguish"
                            }
                        ]
                    }
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:in_rain"
                            },
                            {
                                "type": "origins:fluid_height",
                                "fluid": "water",
                                "comparison": "<",
                                "compare_to": 0.5
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins:change_resource",
                        "resource": "*:*_level",
                        "change": -1,
                        "operation": "add"
                    }
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:or",
                        "conditions": [
                            {
                                "type": "origins:resource",
                                "resource": "*:*_level",
                                "comparison": "<",
                                "compare_to": 100
                            },
                            {
                                "type": "origins:resource",
                                "resource": "ponyorigins:common/00_temp_r",
                                "comparison": "<",
                                "compare_to": 0
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins-math:variable_change_resource",
                        "resource": "*:*_level",
                        "expression": "temp_r",
                        "variables": {
                            "temp_r": "ponyorigins:common/00_temp_r"
                        },
                        "operation": "add"
                    }
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:fluid_height",
                        "fluid": "water",
                        "comparison": ">=",
                        "compare_to": 0.5
                    },
                    "if_action": {
                        "type": "origins:change_resource",
                        "resource": "*:*_level",
                        "change": -1,
                        "operation": "add"
                    }
                }
            ]
        }
    },
