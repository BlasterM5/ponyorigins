{
    "name": "Lithovore",
    "description": "A digestive system designed to eat gemstones to fuel a bioreactor. Normal food turns to ash when eaten, greatly reducing its nutrition while preventing any effects, good or bad. Eat gemstones and fuel items to boost heat quickly. Heat level will increase faster in hot weather, and decrease in cold weather. No heat causes slowness.",
    "badges": [
        {
            "type": "origins:tooltip",
            "text": "Eat gemstones directly",
            "sprite": "textures/item/diamond.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Nether Star equates to Golden Apple",
            "sprite": "textures/item/nether_star.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Eating Food: Saturation -75 percent and no effects",
            "sprite": "textures/item/charcoal.png"
        },
        {
            "type": "origins:tooltip",
            "text": "+2.5 Heat/sec, -0.75 Hunger/sec. Hunger below 6 stops charging",
            "sprite": "textures/particle/flame.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Eat Gems or Fuel to boost heat",
            "sprite": "textures/item/coal.png"
        }
    ],
