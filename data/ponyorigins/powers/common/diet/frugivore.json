{
    "name": "Frugivore",
    "description": "A digestive system designed for fresh fruits only. Abstaining from fruit for too long can accumulate health issues. Eating meat may cause dietary illness.",
    "badges": [
        {
            "type": "origins:tooltip",
            "text": "Eating Fruit: Saturation +200 percent",
            "sprite": "textures/item/apple.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Eating non-fruit Food: Saturation -50 percent",
            "sprite": "textures/item/bread.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Eating off-diet accumulates malnutrition risks",
            "sprite": "textures/item/bone.png"
        },
        {
            "type": "origins:tooltip",
            "text": "Eating Meat: +50 percent chance of dietary illness",
            "sprite": "textures/item/chicken.png"
        }
