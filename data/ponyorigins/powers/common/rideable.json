{
    "name": "Rideable",
    "description": "Other creatures can ride on your back.",
    "badges": [
        {
            "type": "origins:tooltip",
            "text": "When Ridden: Increased Exhaustion by passenger weight",
            "sprite": "textures/item/saddle.png"
        }
    ],
    "type": "origins:multiple",
    "ride": {
        "condition": {
            "type": "origins:passenger",
            "comparison": "==",
            "compare_to": 0
        },
        "type": "origins:action_on_being_used",
        "bientity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:invert",
                    "action": {
                        "type": "origins-math:copy_resource_value",
                        "target_resource": "ponyorigins:common/00_combined_weight",
                        "actor_resource": "ponyorigins:common/00_passenger_weight",
                        "operation": "set"
                    }
                },
                {
                    "type": "origins:mount"
                }
            ]
        },
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:both",
                    "condition": {
                        "type": "origins:entity_type",
                        "entity_type": "player"
                    }
                },
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "inverted": true,
                        "type": "origins:sneaking"
                    }
                },
                {
                    "type": "origins:actor_condition",
                    "condition": {
                        "inverted": true,
                        "type": "origins:sneaking"
                    }
                }
            ]
        },
        "action_result": "success",
        "priority": 0
    },
    "passenger_check": {
        "condition": {
            "type": "origins:passenger",
            "comparison": "==",
            "compare_to": 0
        },
        "type": "origins:action_over_time",
        "interval": 20,
        "rising_action": {
            "type": "origins:change_resource",
            "resource": "ponyorigins:common/00_passenger_weight",
            "change": 0,
            "operation": "set"
        }
    }
}