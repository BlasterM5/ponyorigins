    "tick": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_active",
            "comparison": "==",
            "compare_to": 1
        },
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:food_level",
                        "comparison": ">",
                        "compare_to": 6
                    },
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:exhaust",
                                "amount": 0.4
                            },
                            {
                                "type": "origins:add_velocity",
                                "x": 0,
                                "y": 0.05,
                                "z": 0.5,
                                "space": "local_horizontal",
                                "client": true,
                                "server": true
                            },
                            {
                                "type": "origins:spawn_particles",
                                "particle": "instant_effect",
                                "count": 16,
                                "speed": 1,
                                "force": true,
                                "spread": {
                                    "x": 0.2,
                                    "y": 0.2,
                                    "z": 0.2
                                },
                                "offset_y": 0.5
                            },
                            {
                                "type": "origins:if_else",
                                "condition": {
                                    "type": "origins:resource",
                                    "resource": "*:*_sound_triggered",
                                    "comparison": "==",
                                    "compare_to": 0
