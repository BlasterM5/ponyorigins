                                            "else_action": {
                                                "type": "origins:play_sound",
                                                "sound": "entity.generic.big_fall",
                                                "volume": 1,
                                                "pitch": 1
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "origins:actor_action",
                                "action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:execute_command",
                                            "command": "function ponyorigins:ability/aggro"
