                                "type": "origins:add_velocity",
                                "x": 0,
                                "y": 0.1,
                                "z": 1,
                                "client": false,
                                "server": true
                            }
                        ]
                    },
                    "miss_action": {
                        "type": "origins:if_else",
                        "condition": {
                            "type": "origins:or",
                            "conditions": [
                                {
                                    "type": "origins:block_collision",
                                    "block_condition": {
                                        "type": "origins:movement_blocking"
                                    },
                                    "offset_x": 0.2,
                                    "offset_y": 0.2,
                                    "offset_z": 0.2
                                },
                                {
                                    "type": "origins:block_collision",
                                    "block_condition": {
                                        "type": "origins:movement_blocking"
                                    },
                                    "offset_x": -0.2,
                                    "offset_y": 0.2,
                                    "offset_z": -0.2
                                },
                                {
                                    "type": "origins:block_collision",
                                    "block_condition": {
                                        "type": "origins:movement_blocking"
                                    },
                                    "offset_x": 0.2,
                                    "offset_y": 0.2,
                                    "offset_z": -0.2
                                },
                                {
                                    "type": "origins:block_collision",
                                    "block_condition": {
                                        "type": "origins:movement_blocking"
                                    },
                                    "offset_x": -0.2,
                                    "offset_y": 0.2,
                                    "offset_z": 0.2
                                }
                            ]
                        },
                        "if_action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:change_resource",
                                    "resource": "*:*_cd",
                                    "change": 1,
                                    "operation": "add"
                                },
                                {
                                    "type": "origins:play_sound",
                                    "sound": "entity.generic.big_fall",
                                    "volume": 1,
                                    "pitch": 1
                                },
                                {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins-math:set_resource",
                                            "resource": "*:*_recoil_effect_counter",
                                            "value": "*:*_recoil_effect_multiplier"
                                        },
                                        {
                                            "type": "origins-math:damage",
                                            "amount": "*:*_horn_block_recoil",
                                            "damage_type": "ponyorigins:horn_recoil"
                                        },
                                        {
                                            "type": "origins:if_else",
                                            "condition": {
                                                "type": "origins:power",
                                                "power": "ponyorigins:common/energy"
                                            },
                                            "if_action": {
                                                "type": "origins:and",
                                                "actions": [
                                                    {
                                                        "type": "origins:change_resource",
                                                        "resource": "ponyorigins:common/energy_level",
                                                        "change": 0,
                                                        "operation": "set"
                                                    },
                                                    {
                                                        "type": "origins-math:set_resource",
                                                        "resource": "ponyorigins:common/energy_cd",
                                                        "value": "*:*_horn_cooldown"
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "*:*_cd",
                                            "change": 19,
                                            "operation": "add"
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "falling_action": {
            "type": "origins:change_resource",
            "resource": "*:*_sound_triggered",
            "change": 0,
            "operation": "set"
        }
