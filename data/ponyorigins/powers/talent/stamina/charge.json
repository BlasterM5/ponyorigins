                                            "type": "origins:and",
                                            "actions": [
                                                {
                                                    "type": "origins:change_resource",
                                                    "resource": "*:*_cd",
                                                    "change": 1,
                                                    "operation": "add"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            },
