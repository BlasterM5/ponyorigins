                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:play_sound",
                                            "sound": "entity.firework_rocket.launch",
                                            "volume": 1,
                                            "pitch": 1
                                        },
                                        {
                                            "type": "origins:change_resource",
                                            "resource": "*:*_sound_triggered",
                                            "change": 1,
                                            "operation": "set"
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    "else_action": {
                        "type": "origins:change_resource",
                        "resource": "*:*_active",
                        "change": 0,
                        "operation": "set"
                    }
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:or",
                        "conditions": [
                            {
                                "type": "origins:block_collision",
                                "block_condition": {
                                    "type": "origins:movement_blocking"
                                },
                                "offset_x": 0.2,
                                "offset_y": 0.1,
                                "offset_z": 0.2
                            },
                            {
                                "type": "origins:block_collision",
                                "block_condition": {
                                    "type": "origins:movement_blocking"
                                },
                                "offset_x": -0.2,
                                "offset_y": 0.1,
                                "offset_z": -0.2
                            },
                            {
                                "type": "origins:block_collision",
                                "block_condition": {
                                    "type": "origins:movement_blocking"
                                },
                                "offset_x": 0.2,
                                "offset_y": 0.1,
                                "offset_z": -0.2
                            },
                            {
                                "type": "origins:block_collision",
                                "block_condition": {
                                    "type": "origins:movement_blocking"
                                },
                                "offset_x": -0.2,
                                "offset_y": 0.1,
                                "offset_z": 0.2
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins:raycast",
                        "distance": 1.5,
                        "block": true,
                        "entity": false,
                        "shape_type": "collider",
                        "fluid_handling": "any",
                        "bientity_action": {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins-math:set_resource",
                                        "resource": "*:*_recoil_effect_counter",
                                        "value": "*:*_recoil_effect_multiplier"
                                    },
                                    {
                                        "type": "origins-math:damage",
                                        "amount": "*:*_horn_block_recoil",
                                        "damage_type": "ponyorigins:horn_recoil"
                                    },
                                    {
                                        "type": "origins:if_else",
                                        "condition": {
                                            "type": "origins:resource",
                                            "resource": "*:*_horn",
                                            "comparison": "==",
                                            "compare_to": 1
                                        },
                                        "if_action": {
                                            "type": "origins:and",
                                            "actions": [
                                                {
                                                    "type": "origins:execute_command",
                                                    "command": "function ponyorigins:ability/smash_effect"
                                                },
                                                {
                                                    "type": "origins:raycast",
                                                    "distance": 1.5,
                                                    "block": true,
                                                    "entity": false,
                                                    "shape_type": "collider",
                                                    "fluid_handling": "any",
