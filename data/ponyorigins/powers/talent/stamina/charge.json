                                                        "type": "origins:area_of_effect",
                                                        "radius": 2,
                                                        "shape": "cube",
                                                        "block_condition": {
                                                            "inverted": true,
                                                            "type": "origins:in_tag",
                                                            "tag": "origins:unphasable"
                                                        },
                                                        "block_action": {
                                                            "type": "origins:execute_command",
                                                            "command": "setblock ~ ~ ~ air destroy"
                                                        }
                                                    }
                                                }
                                            ]
                                        },
                                        "else_action": {
                                            "type": "origins:play_sound",
                                            "sound": "entity.generic.big_fall",
                                            "volume": 1,
                                            "pitch": 1
                                        }
                                    },
                                    {
                                        "type": "origins:if_else",
                                        "condition": {
                                            "type": "origins:power",
                                            "power": "ponyorigins:common/energy"
                                        },
                                        "if_action": {
                                            "type": "origins:and",
                                            "actions": [
                                                {
                                                    "type": "origins:change_resource",
                                                    "resource": "ponyorigins:common/energy_level",
                                                    "change": 0,
                                                    "operation": "set"
                                                },
                                                {
                                                    "type": "origins-math:set_resource",
                                                    "resource": "ponyorigins:common/energy_cd",
                                                    "value": "*:*_horn_cooldown"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                {
                    "type": "origins:raycast",
                    "distance": 1.5,
                    "block": true,
                    "entity": true,
                    "shape_type": "collider",
                    "fluid_handling": "any",
                    "bientity_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:if_else",
                                "condition": {
                                    "type": "origins:actor_condition",
                                    "condition": {
                                        "type": "origins:resource",
                                        "resource": "*:*_horn_ap",
                                        "comparison": "==",
                                        "compare_to": 1
                                    }
                                },
                                "if_action": {
                                    "type": "origins-math:variable_execute_command",
                                    "command": "damage %t $horn_damage ponyorigins:horn_stab by %a",
                                    "actor_selector": "%a",
                                    "target_selector": "%t",
                                    "variables": {
                                        "horn_damage": "*:*_horn_damage"
                                    }
                                },
                                "else_action": {
                                    "type": "origins-math:variable_execute_command",
                                    "command": "damage %t $horn ponyorigins:horn_impact by %a",
                                    "actor_selector": "%a",
                                    "target_selector": "%t",
                                    "variables": {
                                        "horn": "*:*_horn_damage"
                                    }
                                }
                            },
                            {
                                "type": "origins:target_action",
                                "action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:if_else",
                                            "condition": {
                                                "type": "origins:resource",
                                                "resource": "*:*_horn",
                                                "comparison": "==",
                                                "compare_to": 1
                                            },
                                            "if_action": {
                                                "type": "origins:execute_command",
                                                "command": "function ponyorigins:ability/smash_effect"
